# Godot 4+ specific ignores
# Ignore system-specific files
.DS_Store
Thumbs.db
desktop.ini

# Godot-specific files
.godot/

# Ignore temporary files and cache
import-*

# Godot export presets - Uncomment if you want to exclude export settings
# export_presets.cfg

# Ignore all resource imports
*.import

# Ignore log files (if any are generated)
*.log

# Other common files
*.tmp
*.bak

# Node modules (if used alongside Godot for scripting or other tools)
node_modules/

# General backup files
*.~*
*.swp
*.swo
